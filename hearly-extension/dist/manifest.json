{
  "name": "Hearly",
  "version": "1.0.0",
  "description": "AI-powered voice focus tool for meetings",
  "manifest_version": 3,
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "content-meet.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://zoom.us/*",
        "https://app.zoom.us/*"
      ],
      "js": [
        "content-zoom.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*"
      ],
      "js": [
        "content-teams.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://meet.google.com/*",
        "https://zoom.us/*",
        "https://app.zoom.us/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*"
      ],
      "js": [
        "injected-mic.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage",
    "tabs",
    "tabCapture",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://zoom.us/*",
    "https://app.zoom.us/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "http://localhost:8787/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected-mic.js",
        "hearly-processor.js"
      ],
      "matches": [
        "https://meet.google.com/*",
        "https://zoom.us/*",
        "https://app.zoom.us/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*"
      ]
    }
  ]
}
